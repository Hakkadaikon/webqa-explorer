# TLC model-checker scratch output
tasks/loopeng/states/
tasks/loopeng/*_TTrace_*.tla
tasks/loopeng/*_TTrace_*.bin

# Tools installed by aqua, Rust build output, coverage and mutation reports
/.aqua
target/
lcov.info
mutants.out*/
__pycache__/
.ruff_cache/

# Claude Code runtime state (.claude/skills is tracked)
.claude/scheduled_tasks.lock
.claude/worktrees/

# Node tools installed from .config/npm/package-lock.json
/.config/npm/node_modules

# Run output of webqa (memory, event log, reports)
.webqa/

# Secrets for local runs (read by webqa at startup; never commit)
.env
